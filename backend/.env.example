PORT=5000

# MySQL Database Connection URL:
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: mysql://root:password@localhost:3306/faculty_tracker
# Hostinger example: mysql://u123456789_user:yourStrongPassword@localhost:3306/u123456789_faculty_tracker
DATABASE_URL="mysql://root:password@localhost:3306/faculty_tracker"

JWT_SECRET="your_secure_jwt_random_secret_string"
NODE_ENV=production
GROQ_API_KEY="your_groq_api_key_here"

