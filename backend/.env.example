PORT=5000
NODE_ENV=production

# MySQL Database Environment Variables
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lectra
DB_USER=lectra_nec
DB_PASSWORD="your_mysql_password_here"

# Prisma Connection URL (auto-generated by backend if DB_* are provided)
DATABASE_URL="mysql://lectra_nec:your_mysql_password_here@localhost:3306/lectra"

JWT_SECRET="your_secure_jwt_random_secret_string"
GROQ_API_KEY="your_groq_api_key_here"
