# ==========================================================
# Hostinger LiteSpeed / Apache Configuration for Node.js
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Prevent directory listings
Options -Indexes

